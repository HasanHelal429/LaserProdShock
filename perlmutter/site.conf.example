# Copy to perlmutter/site.conf (gitignored) and fill in. Everything machine-specific and
# personal lives here so nothing path-dependent is committed.

# NERSC project. GPU allocations MUST end in "_g" -- a CPU project code here is the single
# most common sbatch rejection on Perlmutter. KinShock2020 verified m5032_g on 2026-08-11.
NERSC_ACCOUNT=m5032_g

# Repo and WarpX source. BOTH on $PSCRATCH, never $HOME: the run dirs receive plotfiles
# (every launcher cd's into them) and $HOME is quota'd and not for parallel I/O.
LASERPROD_ROOT=${PSCRATCH:-${SCRATCH:-$HOME}}/LaserProdShock
WARPX_SRC=${PSCRATCH:-${SCRATCH:-$HOME}}/warpx-cda

# ONE build. This project has no A/B on the binary the way KinShock2020 did -- every P5
# leg is full PIC with the ray-tracing deposition operator, so a single 1D CUDA binary
# serves all of them.
WARPX_BUILD=$WARPX_SRC/build_pm_1d

# Pinned COMMIT, not a branch: the binary's provenance has to be a SHA rather than
# "whatever the branch was that day". 534f3b170 is the head of feature/hybrid-laser,
# pushed 2026-08-29 -- the chablis clone and origin now agree, so a fresh Perlmutter
# clone builds exactly what P4 was measured on.
WARPX_COMMIT=534f3b170

# QOS. "shared" bills per-GPU and fits these single-GPU runs; max wall 2 days, 5000 jobs.
# "regular" takes whole 4-GPU nodes and would idle three of them. See perlmutter/README.md.
DEFAULT_QOS=shared
SPINE_TIME=24:00:00
