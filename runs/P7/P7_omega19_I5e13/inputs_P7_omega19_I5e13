diagnostics.diags_names = diag1 diag_fields diag_phase chk

# diag1: fields + all particles (~10 frames)
diag1.intervals = 1798800
diag1.diag_type = Full

# diag_fields: field-only, high cadence (~300 frames) for streaks. Cheap: no particles.
diag_fields.intervals     = 59960
diag_fields.diag_type     = Full
diag_fields.write_species = 0
diag_fields.fields_to_plot = Ez Ey By Bx jz rho rho_targ_electrons rho_targ_ions_C rho_targ_ions_H rho_amb_electrons rho_amb_ions_C rho_amb_ions_H

# diag_phase: particles only, subsampled -- PHASE SPACE IS THE ARBITER of a
# shock claim (density/B streaks of a decaying magnetosonic pulse look
# shock-like; only phase space shows whether ions are reflected).
diag_phase.intervals     = 599600
diag_phase.diag_type     = Full
diag_phase.fields_to_plot = none
diag_phase.species       = targ_ions_C targ_ions_H amb_ions_C amb_ions_H
diag_phase.targ_ions_C.random_fraction = 0.05
diag_phase.targ_ions_H.random_fraction = 0.05
diag_phase.amb_ions_C.random_fraction = 0.05
diag_phase.amb_ions_H.random_fraction = 0.05

# chk: CHECKPOINT/RESTART. The measured cost of a converged spine is ~145 h on
# one A100 against a 48 h queue limit, so a long leg cannot run in a single job
# -- and P5_flashic_off already died at 65% on the 24 h wall with nothing to
# resume from. This is what makes a chained submission possible.
#
# `warpx.break_signals = HUP` plus a Slurm `--signal` (see perlmutter/job.sbatch)
# stops cleanly BEFORE the wall; WarpX's own dump_last_timestep = 1 default then
# writes a checkpoint on the way out, so the pre-wall state is never lost even
# if the wall lands between two scheduled checkpoints.
chk.intervals  = 1998600
chk.diag_type  = Full
chk.format     = checkpoint
warpx.break_signals = HUP
