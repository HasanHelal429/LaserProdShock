# ==========================================================================
# LaserProdShock / P0_bc_periodic -- GENERATED from config.yaml by
# scripts/make_inputs.py. DO NOT EDIT THIS FILE: edit config.yaml and
# regenerate (the config is the single source of truth).
#
# 1D laser ablation of a 1.5 n_cr target into vacuum with all-periodic
# boundaries. Deliberate reproduction of the runaway-ion-front wrap
# failure, to quantify it.
#
# Derived scales (1D, lengths in d_e,critical = 0.1676 um):
#   n_cr = 1.005e+27 m^-3   d_e,cr = lam0/2pi = 0.1676 um
#   target 1.5 n_cr (d_e = 0.1368 um)   ambient: VACUUM
#   dt = 0.0978 fs   t_end = 2.3479 ps   n_cell = 400
#   GATE G1 omega_pe*dt: 0.214 initial, 0.303 at compression; hits 2 at 130.61 n_cr
#   GATE G2 dz/lambda_D: target(cold) 61
#   predicted absorption: tau(flat top) = 70.6, f_abs ~ 1.000
# ==========================================================================

# --- laser / reference (the laser PINS the absolute density scale: IB
#     absorption is measured against n_cr, so lam0 fixes densities in m^-3) ---
my_constants.lam0   = 1.053e-06
my_constants.omega0 = 2.*pi*clight/lam0
my_constants.ncr    = epsilon0*m_e*omega0*omega0/(q_e*q_e)
my_constants.mass_ratio = 100.
my_constants.Mi     = mass_ratio*m_e

# --- densities (in n_cr) and the reference skin depth ---
my_constants.nt     = 1.5*ncr
my_constants.wpe    = sqrt(ncr*q_e^2/(epsilon0*m_e))
my_constants.de     = clight/wpe          # d_e,critical = 0.1676 um
my_constants.di     = de*sqrt(mass_ratio)

# --- target geometry (zt = the LASER-FACING face) ---
my_constants.zt     = -40.*de
my_constants.wt     = 20.*de
my_constants.Ln     = 15.*de

# --- temperatures (theta = kT/(m_e c^2)) ---
my_constants.th_t   = 0.0001        # target electrons: 51.1 eV
my_constants.th_ti  = 1e-06

# --- domain ---
my_constants.zlo = -100.*de
my_constants.zhi = 100.*de

# --- time / solver ---
#
# THE BINDING STABILITY CONDITION IS omega_pe*dt < 2, AND THE GRID CFL CANNOT
# SEE IT. The grid CFL is set by dz/c and knows nothing about how dense the
# plasma is. Upstream, cfl = 0.75 gave omega_pe*dt = 1.91 in a 1.5 n_cr target,
# which then COMPRESSED under its own ablation to 2.43 -- total particle energy
# grew 21x while the laser had supplied 1/1400 of it, and every number measured
# past t ~ 0.1 gyroperiods was a measurement of that instability.
#   here: omega_pe*dt = 0.214 initially, 0.303 at the assumed compression,
#   and the limit of 2 is not touched until 130.61 n_cr.
max_step      = 24000
warpx.cfl     = 0.35
warpx.verbose = 1          # REQUIRED: the LASERDEP diagnostic lines

# --- grid (dz = 0.5 d_e; z = propagation axis) ---
amr.n_cell        = 400
amr.max_level     = 0      # the operator asserts finestLevel() == 0 (no AMR)
geometry.dims     = 1
geometry.prob_lo  = zlo
geometry.prob_hi  = zhi

# boundaries: z periodic/periodic
#   NOTE the propagation axis is PERIODIC: WarpX ties particle BCs to field
#   BCs, so a runaway ablation front will WRAP onto the far side. Control
#   runs only (meta.expect_wrap).
boundary.field_lo    = periodic
boundary.field_hi    = periodic
boundary.particle_lo = periodic
boundary.particle_hi = periodic

algo.particle_shape = 2

# --- background field (none) ---
warpx.Bx_external_grid_function(x,y,z) = "0."
warpx.By_external_grid_function(x,y,z) = "0."
warpx.Bz_external_grid_function(x,y,z) = "0."
warpx.B_ext_grid_init_style       = parse_B_ext_grid_function

particles.species_names = targ_electrons targ_ions

# --- target electrons ---
targ_electrons.species_type = electron
targ_electrons.injection_style = "NUniformPerCell"
targ_electrons.num_particles_per_cell_each_dim = 200
targ_electrons.profile = parse_density_function
targ_electrons.density_function(x,y,z) = "nt*((z<=zt)*(z>=zt-wt) + (z>zt)*exp(-((z-zt)/Ln)^2))"
targ_electrons.density_min = 1.e-4*nt
targ_electrons.momentum_distribution_type = maxwellian
targ_electrons.maxwellian_u_std_distribution_type = "constant"
targ_electrons.ux_std = sqrt(th_t)
targ_electrons.uy_std = sqrt(th_t)
targ_electrons.uz_std = sqrt(th_t)

# --- target ions ---
targ_ions.charge = q_e
targ_ions.mass   = Mi
targ_ions.injection_style = "NUniformPerCell"
targ_ions.num_particles_per_cell_each_dim = 200
targ_ions.profile = parse_density_function
targ_ions.density_function(x,y,z) = "nt*((z<=zt)*(z>=zt-wt) + (z>zt)*exp(-((z-zt)/Ln)^2))"
targ_ions.density_min = 1.e-4*nt
targ_ions.momentum_distribution_type = maxwellian
targ_ions.maxwellian_u_std_distribution_type = "constant"
targ_ions.ux_std = sqrt((th_ti)/mass_ratio)
targ_ions.uy_std = sqrt((th_ti)/mass_ratio)
targ_ions.uz_std = sqrt((th_ti)/mass_ratio)

# ------------------------------------------------------------------------
# --- LASER DEPOSITION (ray tracing) -- the operator under test ---
#
# K ~ Z_eff lnLambda n_e^2 T_e^{-3/2} / sqrt(1 - n_e/n_cr), so absorption is
# SELF-LIMITING: a cold target absorbs strongly and shuts itself off as the
# corona heats and rarefies. That is real laser-plasma coupling, and it is only
# captured because temperature_mode = local measures T_e per cell.
#
# Z_eff/lnLambda are a VERY STRONG knob: upstream, 5/5 -> 13/7 coupled 16x more
# energy and produced a 0.06 c piston that crossed the domain in a fraction of a
# gyroperiod. Change them in small steps.
# ------------------------------------------------------------------------
laser_deposition.species              = targ_electrons
laser_deposition.wavelength           = lam0
laser_deposition.intensity            = 1e18
laser_deposition.direction            = z
laser_deposition.inject_side          = hi
laser_deposition.incidence_angle      = 0.        # 0 deg
laser_deposition.Z_eff                = 5.
laser_deposition.coulomb_log          = 5.
laser_deposition.electron_temperature = th_t
laser_deposition.temperature_mode     = local
laser_deposition.ray_cfl              = 0.25
laser_deposition.intervals            = 10
# per-cell (coords, n_e, H, P_abs) dump. ANALYSE THE STEP-0 TABLE: later
# dumps drift as the kicks move electrons.
laser_deposition.profile_intervals    = 8000
laser_deposition.profile_prefix       = diags/laserdep_profile

# --- diagnostics ---
# EP/FE close gate G6: the tracer's own LASERDEP Eabs is immune to grid heating,
# the particle energy is not, so their difference IS the grid-heating budget.
warpx.reduced_diags_names = EP FE PN
EP.type      = ParticleEnergy
EP.intervals = 200
FE.type      = FieldEnergy
FE.intervals = 200
PN.type      = ParticleNumber
PN.intervals = 200

diagnostics.diags_names = diag1 diag_fields diag_phase

# diag1: fields + all particles (~10 frames)
diag1.intervals = 2400
diag1.diag_type = Full

# diag_fields: field-only, high cadence (~60 frames) for streaks. Cheap: no particles.
diag_fields.intervals     = 400
diag_fields.diag_type     = Full
diag_fields.write_species = 0
diag_fields.fields_to_plot = Ez Ey By Bx jz rho rho_targ_electrons rho_targ_ions

# diag_phase: particles only, subsampled -- PHASE SPACE IS THE ARBITER of a
# shock claim (density/B streaks of a decaying magnetosonic pulse look
# shock-like; only phase space shows whether ions are reflected).
diag_phase.intervals     = 1200
diag_phase.diag_type     = Full
diag_phase.fields_to_plot = none
diag_phase.species       = targ_ions
diag_phase.targ_ions.random_fraction = 0.05
