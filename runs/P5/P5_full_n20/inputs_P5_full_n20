#
# THE DENSITY-CAP A/B, at real mass. One change from P5_full:
# density_over_ncr 10 -> 20. It tests the leading structural candidate for
# the 0.69x plume-T_e gap that survived P4. Everything cheap has already
# been eliminated: the deposition operator is cleared (retraction ledger
# 21 -- at matched f_abs, T_e does not move), the density floor is worth
# <4% on the FLASH-fitted exponential (ledger 20), and f_abs is now
# matched to 3.4% so no absorption correction is in play. What has never
# been tested at real mass is the concession that is structural rather
# than numerical: FLASH's target is solid Al at 795 n_cr and ours is
# capped at 10. The paper's own Appendix-A scan (2/5/10/20 n_cr) found T_e
# matches FLASH only for n_max >= 5, which is read here as evidence the
# cap is a live lever near our operating point rather than a settled one
# -- and that scan was run at a REDUCED mass ratio, where HANDOFF.md 7.4
# shows absorption is broken by construction. So it does not transfer.
# Read as a two-point derivative: if plume T_e moves materially between 10
# and 20 n_cr, the cap is binding and part of the 0.69x is a
# reservoir/opacity artifact rather than a code difference. If it does not
# move, the cap is eliminated and attention goes to electron thermal
# transport (D3 Appendix C, never run).
#
# Derived scales (1D, lengths in d_e,critical = 0.1693 um):
#   n_cr = 9.848e+26 m^-3   d_e,cr = lam0/2pi = 0.1693 um
#   target 20 n_cr (d_e = 0.0379 um)   ambient: VACUUM
#   dt = 0.0989 fs   t_end = 903.4446 ps   n_cell = 22040
#   GATE G1 omega_pe*dt: 0.783 initial, 1.107 at compression; hits 2 at 130.61 n_cr
#   GATE G2 dz/lambda_D: target(cold) 82
#   predicted absorption: tau(flat top) = 233, f_abs ~ 1.000
# ==========================================================================

# --- laser / reference (the laser PINS the absolute density scale: IB
#     absorption is measured against n_cr, so lam0 fixes densities in m^-3) ---
my_constants.lam0   = 1.064e-06
my_constants.omega0 = 2.*pi*clight/lam0
my_constants.ncr    = epsilon0*m_e*omega0*omega0/(q_e*q_e)
my_constants.mass_ratio = 49542.
my_constants.Mi     = mass_ratio*m_e

# --- densities (in n_cr) and the reference skin depth ---
my_constants.nt     = 20.*ncr
my_constants.wpe    = sqrt(ncr*q_e^2/(epsilon0*m_e))
my_constants.de     = clight/wpe          # d_e,critical = 0.1693 um
my_constants.di     = de*sqrt(mass_ratio)

# --- target geometry (zt = the LASER-FACING face) ---
my_constants.zt     = 0.*de
my_constants.wt     = 500.*de
my_constants.Ln     = 29.8024*de
my_constants.ncor   = 1.*ncr      # corona amplitude, independent of the slab
my_constants.zcor   = 9.9173*de      # where the corona reaches ncor
my_constants.th_ts  = 2.466e-06        # SOLID electrons: 1.26 eV
my_constants.th_tis = 3.914e-06
my_constants.uza    = 0.00035638          # corona drift u_z = uza + uzb*z/de
my_constants.uzb    = 8.4922e-06

# --- temperatures (theta = kT/(m_e c^2)) ---
my_constants.th_t   = 0.00074032        # target electrons: 378.3 eV
my_constants.th_ti  = 0.00022622

# --- domain ---
my_constants.zlo = -521.4251*de
my_constants.zhi = 10498.5749*de

# --- time / solver ---
#
# THE BINDING STABILITY CONDITION IS omega_pe*dt < 2, AND THE GRID CFL CANNOT
# SEE IT. The grid CFL is set by dz/c and knows nothing about how dense the
# plasma is. Upstream, cfl = 0.75 gave omega_pe*dt = 1.91 in a 1.5 n_cr target,
# which then COMPRESSED under its own ablation to 2.43 -- total particle energy
# grew 21x while the laser had supplied 1/1400 of it, and every number measured
# past t ~ 0.1 gyroperiods was a measurement of that instability.
#   here: omega_pe*dt = 0.783 initially, 1.107 at the assumed compression,
#   and the limit of 2 is not touched until 130.61 n_cr.
max_step      = 9139500
warpx.cfl     = 0.35
warpx.verbose = 1          # REQUIRED: the LASERDEP diagnostic lines

# --- grid (dz = 0.5 d_e; z = propagation axis) ---
amr.n_cell        = 22040
amr.max_level     = 0      # the operator asserts finestLevel() == 0 (no AMR)
amr.max_grid_size = 22040
amrex.the_arena_init_size = 4294967296  # 4096 MiB -- see numerics.arena_init_size_mb
geometry.dims     = 1
geometry.prob_lo  = zlo
geometry.prob_hi  = zhi

# boundaries: z reflecting/open
boundary.field_lo    = pec
boundary.field_hi    = pec
boundary.particle_lo = reflecting
boundary.particle_hi = absorbing


# --- Coulomb collisions ----------------------------------------------
collisions.collision_names = c_targ_electrons c_targ_electrons_targ_ions c_targ_ions
c_targ_electrons.type    = pairwisecoulomb
c_targ_electrons.species = targ_electrons targ_electrons
c_targ_electrons.CoulombLog = 6.3
c_targ_electrons.ndt_supercycle = 10
c_targ_electrons_targ_ions.type    = pairwisecoulomb
c_targ_electrons_targ_ions.species = targ_electrons targ_ions
c_targ_electrons_targ_ions.CoulombLog = 6.3
c_targ_electrons_targ_ions.ndt_supercycle = 10
c_targ_ions.type    = pairwisecoulomb
c_targ_ions.species = targ_ions targ_ions
c_targ_ions.CoulombLog = 6.3
c_targ_ions.ndt_supercycle = 10

algo.particle_shape = 2
warpx.random_seed  = 20260829

# --- background field (none) ---
warpx.Bx_external_grid_function(x,y,z) = "0."
warpx.By_external_grid_function(x,y,z) = "0."
warpx.Bz_external_grid_function(x,y,z) = "0."
warpx.B_ext_grid_init_style       = parse_B_ext_grid_function

particles.species_names = targ_electrons targ_ions

# --- target electrons ---
targ_electrons.species_type = electron
targ_electrons.injection_style = "NUniformPerCell"
targ_electrons.num_particles_per_cell_each_dim = 500
targ_electrons.profile = parse_density_function
targ_electrons.density_function(x,y,z) = "nt*((z<=zt)*(z>=zt-wt)) + ncor*(z>zt)*exp(-((1*(z-zt)-zcor)/Ln))"
targ_electrons.density_min = 1.e-6*nt
targ_electrons.momentum_distribution_type = maxwellian
targ_electrons.maxwellian_u_std_distribution_type = "parser"
targ_electrons.ux_std_function(x,y,z) = "sqrt((th_ts+(th_t-th_ts)*(z>zt)))"
targ_electrons.uy_std_function(x,y,z) = "sqrt((th_ts+(th_t-th_ts)*(z>zt)))"
targ_electrons.uz_std_function(x,y,z) = "sqrt((th_ts+(th_t-th_ts)*(z>zt)))"
targ_electrons.maxwellian_u_mean_distribution_type = "parser"
targ_electrons.ux_mean_function(x,y,z) = "0"
targ_electrons.uy_mean_function(x,y,z) = "0"
targ_electrons.uz_mean_function(x,y,z) = "(uza+uzb*(z-zt)/de)*(z>zt)"

# --- target ions ---
targ_ions.charge = 13*q_e
targ_ions.mass   = Mi
targ_ions.injection_style = "NUniformPerCell"
targ_ions.num_particles_per_cell_each_dim = 500
targ_ions.profile = parse_density_function
targ_ions.density_function(x,y,z) = "(nt*((z<=zt)*(z>=zt-wt)) + ncor*(z>zt)*exp(-((1*(z-zt)-zcor)/Ln)))/13"
targ_ions.density_min = 1.e-6*nt/13
targ_ions.momentum_distribution_type = maxwellian
targ_ions.maxwellian_u_std_distribution_type = "parser"
targ_ions.ux_std_function(x,y,z) = "sqrt(((th_tis+(th_ti-th_tis)*(z>zt)))/mass_ratio)"
targ_ions.uy_std_function(x,y,z) = "sqrt(((th_tis+(th_ti-th_tis)*(z>zt)))/mass_ratio)"
targ_ions.uz_std_function(x,y,z) = "sqrt(((th_tis+(th_ti-th_tis)*(z>zt)))/mass_ratio)"
targ_ions.maxwellian_u_mean_distribution_type = "parser"
targ_ions.ux_mean_function(x,y,z) = "0"
targ_ions.uy_mean_function(x,y,z) = "0"
targ_ions.uz_mean_function(x,y,z) = "(uza+uzb*(z-zt)/de)*(z>zt)"

# ------------------------------------------------------------------------
# --- LASER DEPOSITION (ray tracing) -- the operator under test ---
#
# K ~ Z_eff lnLambda n_e^2 T_e^{-3/2} / sqrt(1 - n_e/n_cr), so absorption is
# SELF-LIMITING: a cold target absorbs strongly and shuts itself off as the
# corona heats and rarefies. That is real laser-plasma coupling, and it is only
# captured because temperature_mode = local measures T_e per cell.
#
# Z_eff/lnLambda are a VERY STRONG knob: upstream, 5/5 -> 13/7 coupled 16x more
# energy and produced a 0.06 c piston that crossed the domain in a fraction of a
# gyroperiod. Change them in small steps.
# ------------------------------------------------------------------------
laser_deposition.species              = targ_electrons
laser_deposition.wavelength           = lam0
laser_deposition.intensity            = 1e17
laser_deposition.direction            = z
laser_deposition.inject_side          = hi
laser_deposition.incidence_angle      = 0.        # 0 deg
laser_deposition.Z_eff                = 13.
laser_deposition.coulomb_log          = 6.3
laser_deposition.coulomb_log_mode     = nrl
laser_deposition.electron_temperature = th_t
laser_deposition.temperature_mode     = local
laser_deposition.temperature_floor    = 1.9569e-06
laser_deposition.min_macroparticles_per_cell = 1.
laser_deposition.ray_cfl              = 0.25
laser_deposition.intervals            = 10
# per-cell (coords, n_e, H, P_abs) dump. ANALYSE THE STEP-0 TABLE: later
