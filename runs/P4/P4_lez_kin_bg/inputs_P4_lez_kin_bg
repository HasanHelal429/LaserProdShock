#
# Phase-4 fully KINETIC leg of the three-way cross-code benchmark against
# Lezhnin 2025 (Phys. Plasmas 32, 022701). Long-pulse (1 ns, 1e17 W/m^2,
# 1.064 um) ray-traced ablation of a fully-ionised aluminium target into
# vacuum, 1D, with Coulomb collisions ON -- the paper is explicit that
# collisions are load-bearing. This is the WarpX counterpart of the
# paper's PSC run, and the arbiter for the hybrid leg P4_lez_hyb, which
# differs from it ONLY in the electron closure.
#
# Derived scales (1D, lengths in d_e,critical = 0.1693 um):
#   n_cr = 9.848e+26 m^-3   d_e,cr = lam0/2pi = 0.1693 um
#   target 10 n_cr (d_e = 0.0536 um)   ambient 0.001 n_cr (d_e = 5.3550 um, d_i = 278.152 um)
#   dt = 0.0989 fs   t_end = 54.6604 ps   n_cell = 5000
#   GATE G1 omega_pe*dt: 0.553 initial, 0.783 at compression; hits 2 at 130.61 n_cr
#   GATE G2 dz/lambda_D: target(cold) 113, ambient 11.3
#   predicted absorption: tau(flat top) = 188, f_abs ~ 1.000; ambient traverse eats 27.929%
# ==========================================================================

# --- laser / reference (the laser PINS the absolute density scale: IB
#     absorption is measured against n_cr, so lam0 fixes densities in m^-3) ---
my_constants.lam0   = 1.064e-06
my_constants.omega0 = 2.*pi*clight/lam0
my_constants.ncr    = epsilon0*m_e*omega0*omega0/(q_e*q_e)
my_constants.mass_ratio = 2698.
my_constants.Mi     = mass_ratio*m_e

# --- densities (in n_cr) and the reference skin depth ---
my_constants.nt     = 10.*ncr
my_constants.namb   = 0.001*ncr
my_constants.wpe    = sqrt(ncr*q_e^2/(epsilon0*m_e))
my_constants.de     = clight/wpe          # d_e,critical = 0.1693 um
my_constants.di     = de*sqrt(mass_ratio)

# --- target geometry (zt = the LASER-FACING face) ---
my_constants.zt     = 0.*de
my_constants.wt     = 45.*de
my_constants.Ln     = 27.*de

# --- temperatures (theta = kT/(m_e c^2)) ---
my_constants.th_t   = 0.0001957        # target electrons: 100 eV
my_constants.th_ti  = 1.957e-05
my_constants.th_a   = 1.957e-06
my_constants.th_ai  = 1.957e-07

# --- domain ---
my_constants.zlo = -50.*de
my_constants.zhi = 2450.*de

# --- time / solver ---
#
# THE BINDING STABILITY CONDITION IS omega_pe*dt < 2, AND THE GRID CFL CANNOT
# SEE IT. The grid CFL is set by dz/c and knows nothing about how dense the
# plasma is. Upstream, cfl = 0.75 gave omega_pe*dt = 1.91 in a 1.5 n_cr target,
# which then COMPRESSED under its own ablation to 2.43 -- total particle energy
# grew 21x while the laser had supplied 1/1400 of it, and every number measured
# past t ~ 0.1 gyroperiods was a measurement of that instability.
#   here: omega_pe*dt = 0.553 initially, 0.783 at the assumed compression,
#   and the limit of 2 is not touched until 130.61 n_cr.
max_step      = 552960
warpx.cfl     = 0.35
warpx.verbose = 1          # REQUIRED: the LASERDEP diagnostic lines

# --- grid (dz = 0.5 d_e; z = propagation axis) ---
amr.n_cell        = 5000
amr.max_level     = 0      # the operator asserts finestLevel() == 0 (no AMR)
amr.max_grid_size = 5000
geometry.dims     = 1
geometry.prob_lo  = zlo
geometry.prob_hi  = zhi

# boundaries: z open/open
boundary.field_lo    = pec
boundary.field_hi    = pec
boundary.particle_lo = absorbing
boundary.particle_hi = absorbing


# --- Coulomb collisions ----------------------------------------------
collisions.collision_names = c_targ_electrons c_targ_electrons_targ_ions c_targ_ions
c_targ_electrons.type    = pairwisecoulomb
c_targ_electrons.species = targ_electrons targ_electrons
c_targ_electrons.CoulombLog = 6.3
c_targ_electrons.ndt_supercycle = 10
c_targ_electrons_targ_ions.type    = pairwisecoulomb
c_targ_electrons_targ_ions.species = targ_electrons targ_ions
c_targ_electrons_targ_ions.CoulombLog = 6.3
c_targ_electrons_targ_ions.ndt_supercycle = 10
c_targ_ions.type    = pairwisecoulomb
c_targ_ions.species = targ_ions targ_ions
c_targ_ions.CoulombLog = 6.3
c_targ_ions.ndt_supercycle = 10

algo.particle_shape = 2

# --- background field (none) ---
warpx.Bx_external_grid_function(x,y,z) = "0."
warpx.By_external_grid_function(x,y,z) = "0."
warpx.Bz_external_grid_function(x,y,z) = "0."
warpx.B_ext_grid_init_style       = parse_B_ext_grid_function

particles.species_names = targ_electrons targ_ions amb_electrons amb_ions

# --- target electrons ---
targ_electrons.species_type = electron
targ_electrons.injection_style = "NUniformPerCell"
targ_electrons.num_particles_per_cell_each_dim = 500
targ_electrons.profile = parse_density_function
targ_electrons.density_function(x,y,z) = "nt*((z<=zt)*(z>=zt-wt) + (z>zt)*exp(-((z-zt)/Ln)^2))"
targ_electrons.density_min = 1.e-4*namb
targ_electrons.momentum_distribution_type = maxwellian
targ_electrons.maxwellian_u_std_distribution_type = "constant"
targ_electrons.ux_std = sqrt(th_t)
targ_electrons.uy_std = sqrt(th_t)
targ_electrons.uz_std = sqrt(th_t)

# --- target ions ---
targ_ions.charge = 13*q_e
targ_ions.mass   = Mi
targ_ions.injection_style = "NUniformPerCell"
targ_ions.num_particles_per_cell_each_dim = 500
targ_ions.profile = parse_density_function
targ_ions.density_function(x,y,z) = "(nt*((z<=zt)*(z>=zt-wt) + (z>zt)*exp(-((z-zt)/Ln)^2)))/13"
targ_ions.density_min = 1.e-4*namb
targ_ions.momentum_distribution_type = maxwellian
targ_ions.maxwellian_u_std_distribution_type = "constant"
targ_ions.ux_std = sqrt(th_ti)
targ_ions.uy_std = sqrt(th_ti)
targ_ions.uz_std = sqrt(th_ti)

# --- ambient electrons ---
amb_electrons.species_type = electron
amb_electrons.injection_style = "NUniformPerCell"
amb_electrons.num_particles_per_cell_each_dim = 50
amb_electrons.profile = parse_density_function
amb_electrons.density_function(x,y,z) = "namb*((z>zt)+(z<zt-wt))"
amb_electrons.density_min = 1.e-4*namb
amb_electrons.momentum_distribution_type = maxwellian
amb_electrons.maxwellian_u_std_distribution_type = "constant"
amb_electrons.ux_std = sqrt(th_a)
amb_electrons.uy_std = sqrt(th_a)
amb_electrons.uz_std = sqrt(th_a)

# --- ambient ions ---
amb_ions.charge = 13*q_e
amb_ions.mass   = Mi
amb_ions.injection_style = "NUniformPerCell"
amb_ions.num_particles_per_cell_each_dim = 50
amb_ions.profile = parse_density_function
amb_ions.density_function(x,y,z) = "(namb*((z>zt)+(z<zt-wt)))/13"
amb_ions.density_min = 1.e-4*namb
amb_ions.momentum_distribution_type = maxwellian
amb_ions.maxwellian_u_std_distribution_type = "constant"
amb_ions.ux_std = sqrt(th_ai)
amb_ions.uy_std = sqrt(th_ai)
amb_ions.uz_std = sqrt(th_ai)

# ------------------------------------------------------------------------
# --- LASER DEPOSITION (ray tracing) -- the operator under test ---
#
# K ~ Z_eff lnLambda n_e^2 T_e^{-3/2} / sqrt(1 - n_e/n_cr), so absorption is
# SELF-LIMITING: a cold target absorbs strongly and shuts itself off as the
# corona heats and rarefies. That is real laser-plasma coupling, and it is only
# captured because temperature_mode = local measures T_e per cell.
#
# Z_eff/lnLambda are a VERY STRONG knob: upstream, 5/5 -> 13/7 coupled 16x more
# energy and produced a 0.06 c piston that crossed the domain in a fraction of a
# gyroperiod. Change them in small steps.
# ------------------------------------------------------------------------
laser_deposition.species              = targ_electrons amb_electrons
laser_deposition.wavelength           = lam0
laser_deposition.intensity            = 1e17
laser_deposition.direction            = z
laser_deposition.inject_side          = hi
laser_deposition.incidence_angle      = 0.        # 0 deg
laser_deposition.Z_eff                = 13.
laser_deposition.coulomb_log          = 6.3
laser_deposition.electron_temperature = th_t
laser_deposition.temperature_mode     = local
laser_deposition.ray_cfl              = 0.25
laser_deposition.intervals            = 10
# per-cell (coords, n_e, H, P_abs) dump. ANALYSE THE STEP-0 TABLE: later
# dumps drift as the kicks move electrons.
laser_deposition.profile_intervals    = 27648
laser_deposition.profile_prefix       = diags/laserdep_profile

# --- diagnostics ---
# EP/FE close gate G6: the tracer's own LASERDEP Eabs is immune to grid heating,
