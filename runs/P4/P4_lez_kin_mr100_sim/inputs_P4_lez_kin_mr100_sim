particles.species_names = targ_electrons targ_ions

# --- target electrons ---
targ_electrons.species_type = electron
targ_electrons.injection_style = "NUniformPerCell"
targ_electrons.num_particles_per_cell_each_dim = 500
targ_electrons.profile = parse_density_function
targ_electrons.density_function(x,y,z) = "nt*((z<=zt)*(z>=zt-wt)) + ncor*(z>zt)*exp(-((1*(z-zt)-zcor)/Ln))"
targ_electrons.density_min = 1.e-6*nt
targ_electrons.momentum_distribution_type = maxwellian
targ_electrons.maxwellian_u_std_distribution_type = "parser"
targ_electrons.ux_std_function(x,y,z) = "sqrt((th_ts+(th_t-th_ts)*(z>zt)))"
targ_electrons.uy_std_function(x,y,z) = "sqrt((th_ts+(th_t-th_ts)*(z>zt)))"
targ_electrons.uz_std_function(x,y,z) = "sqrt((th_ts+(th_t-th_ts)*(z>zt)))"
targ_electrons.maxwellian_u_mean_distribution_type = "parser"
targ_electrons.ux_mean_function(x,y,z) = "0"
targ_electrons.uy_mean_function(x,y,z) = "0"
targ_electrons.uz_mean_function(x,y,z) = "(uza+uzb*(z-zt)/de)*(z>zt)"

# --- target ions ---
targ_ions.charge = 13*q_e
targ_ions.mass   = Mi
targ_ions.injection_style = "NUniformPerCell"
targ_ions.num_particles_per_cell_each_dim = 500
targ_ions.profile = parse_density_function
targ_ions.density_function(x,y,z) = "(nt*((z<=zt)*(z>=zt-wt)) + ncor*(z>zt)*exp(-((1*(z-zt)-zcor)/Ln)))/13"
targ_ions.density_min = 1.e-6*nt/13
targ_ions.momentum_distribution_type = maxwellian
targ_ions.maxwellian_u_std_distribution_type = "parser"
targ_ions.ux_std_function(x,y,z) = "sqrt(((th_tis+(th_ti-th_tis)*(z>zt)))/mass_ratio)"
targ_ions.uy_std_function(x,y,z) = "sqrt(((th_tis+(th_ti-th_tis)*(z>zt)))/mass_ratio)"
targ_ions.uz_std_function(x,y,z) = "sqrt(((th_tis+(th_ti-th_tis)*(z>zt)))/mass_ratio)"
targ_ions.maxwellian_u_mean_distribution_type = "parser"
targ_ions.ux_mean_function(x,y,z) = "0"
targ_ions.uy_mean_function(x,y,z) = "0"
targ_ions.uz_mean_function(x,y,z) = "(uza+uzb*(z-zt)/de)*(z>zt)"

# ------------------------------------------------------------------------
