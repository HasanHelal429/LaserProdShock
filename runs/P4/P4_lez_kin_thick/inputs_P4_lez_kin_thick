laser_deposition.direction            = z
laser_deposition.inject_side          = hi
laser_deposition.incidence_angle      = 0.        # 0 deg
laser_deposition.Z_eff                = 13.
laser_deposition.coulomb_log          = 6.3
laser_deposition.electron_temperature = th_t
laser_deposition.temperature_mode     = local
laser_deposition.ray_cfl              = 0.25
laser_deposition.intervals            = 10
# per-cell (coords, n_e, H, P_abs) dump. ANALYSE THE STEP-0 TABLE: later
