my_constants.x0B    = 0.0012900000000000001   # B = Bpk*x0B/(d+x0B), d = distance from the face [m]
my_constants.B0     = 3.006993006993007      # B at 3 mm, the reference [T]

# --- domain ---
my_constants.zlo = -355.0891*de
